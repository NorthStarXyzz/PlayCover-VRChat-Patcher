diff --git a/PlayCover/Model/PlayApp.swift b/PlayCover/Model/PlayApp.swift
--- a/PlayCover/Model/PlayApp.swift
+++ b/PlayCover/Model/PlayApp.swift
@@ -113,8 +113,39 @@ class PlayApp: BaseApp {
                     runAppExec()
                 }
             }
         } catch {
-            Log.shared.error(error)
+            if resolvedLaunchMode == .vrChatCompatible,
+               let policyError = error as? VRChatMemoryPolicyClientError,
+               policyError.shouldOfferControllerStartCommand {
+                await MainActor.run {
+                    presentControllerUnavailableAlert()
+                }
+            } else {
+                Log.shared.error(error)
+            }
         }
     }
+
+    @MainActor
+    private func presentControllerUnavailableAlert() {
+        let command = VRChatMemoryPolicyManifest.controllerStartCommand
+        let alert = NSAlert()
+        alert.alertStyle = .warning
+        alert.messageText = NSLocalizedString(
+            "error.vrchatMemoryPolicy.controllerUnavailable.title", comment: ""
+        )
+        alert.informativeText = String(format: NSLocalizedString(
+            "error.vrchatMemoryPolicy.controllerUnavailable.message", comment: ""
+        ), command)
+        alert.addButton(withTitle: NSLocalizedString(
+            "error.vrchatMemoryPolicy.controllerUnavailable.copyCommand", comment: ""
+        ))
+        alert.addButton(withTitle: NSLocalizedString("button.Cancel", comment: ""))
+
+        if alert.runModal() == .alertFirstButtonReturn {
+            let pasteboard = NSPasteboard.general
+            pasteboard.clearContents()
+            pasteboard.setString(command, forType: .string)
+        }
+    }
 }
